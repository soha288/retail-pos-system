<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>OmniPOS - Sign In / Sign Up</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    min-height:100vh;
    background: linear-gradient(135deg,#0f172a,#1e293b,#111827);
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
}

/* Animated background */
body::before{
    content:'';
    position:absolute;
    width:500px;
    height:500px;
    background:#2563eb;
    filter:blur(180px);
    top:-150px;
    left:-100px;
    opacity:.3;
    animation: float1 8s infinite ease-in-out;
}

body::after{
    content:'';
    position:absolute;
    width:450px;
    height:450px;
    background:#7c3aed;
    filter:blur(180px);
    bottom:-120px;
    right:-100px;
    opacity:.25;
    animation: float2 8s infinite ease-in-out;
}

@keyframes float1{
    50%{
        transform:translateY(40px);
    }
}
@keyframes float2{
    50%{
        transform:translateY(-40px);
    }
}

.container{
    position:relative;
    width:950px;
    max-width:95%;
    height:600px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(20px);
    border-radius:30px;
    overflow:hidden;
    display:flex;
    box-shadow:0 30px 80px rgba(0,0,0,.5);
}

/* Left Panel */
.left{
    width:50%;
    padding:50px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    color:white;
    position:relative;
}

.logo{
    font-size:36px;
    font-weight:700;
    margin-bottom:10px;
}

.tag{
    text-align:center;
    opacity:.8;
    margin-bottom:30px;
}

/* Parcel Character */
.character{
    position:relative;
    width:220px;
    height:220px;
    margin-bottom:20px;
}

.parcel{
    position:absolute;
    width:180px;
    height:160px;
    background:#d97706;
    border-radius:20px;
    top:40px;
    left:20px;
    box-shadow:0 10px 25px rgba(0,0,0,.35);
}

.tape{
    position:absolute;
    width:40px;
    height:160px;
    background:#fde68a;
    left:70px;
}

.eye{
    width:35px;
    height:35px;
    background:white;
    border-radius:50%;
    position:absolute;
    top:45px;
    overflow:hidden;
}

.eye.left-eye{
    left:35px;
}

.eye.right-eye{
    right:35px;
}

.pupil{
    width:14px;
    height:14px;
    background:#111827;
    border-radius:50%;
    position:absolute;
    top:10px;
    left:10px;
    transition:.08s linear;
}

.mouth{
    position:absolute;
    width:45px;
    height:8px;
    background:#111827;
    border-radius:50px;
    bottom:40px;
    left:50%;
    transform:translateX(-50%);
}

/* Boss parcel */
.boss{
    position:absolute;
    top:-10px;
    right:-10px;
    width:90px;
    height:90px;
    background:#f59e0b;
    border-radius:16px;
    display:flex;
    justify-content:center;
    align-items:center;
    transform:rotate(-10deg);
    transition:.4s;
}

.boss-eye{
    width:18px;
    height:18px;
    background:white;
    border-radius:50%;
    margin:5px;
    overflow:hidden;
    position:relative;
}

.boss-pupil{
    width:7px;
    height:7px;
    background:black;
    border-radius:50%;
    position:absolute;
    top:5px;
    left:5px;
    transition:.2s;
}

/* Right Panel */
.right{
    width:50%;
    background:rgba(255,255,255,0.03);
    padding:50px;
    display:flex;
    justify-content:center;
    align-items:center;
}

.form-box{
    width:100%;
}

.form-box h2{
    color:white;
    font-size:34px;
    margin-bottom:10px;
}

.form-box p{
    color:#cbd5e1;
    margin-bottom:30px;
}

.input-group{
    margin-bottom:18px;
}

.input-group input{
    width:100%;
    padding:16px;
    border:none;
    border-radius:14px;
    outline:none;
    background:rgba(255,255,255,0.08);
    color:white;
    font-size:15px;
}

.input-group input::placeholder{
    color:#cbd5e1;
}

.btn{
    width:100%;
    padding:16px;
    border:none;
    border-radius:14px;
    background:linear-gradient(to right,#2563eb,#7c3aed);
    color:white;
    font-size:16px;
    cursor:pointer;
    font-weight:600;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-3px);
}

.switch{
    text-align:center;
    margin-top:20px;
    color:#cbd5e1;
}

.switch span{
    color:#60a5fa;
    cursor:pointer;
    font-weight:600;
}

@media(max-width:850px){
    .container{
        flex-direction:column;
        height:auto;
    }

    .left,.right{
        width:100%;
    }
}
</style>
</head>
<body>

<div class="container">

    <div class="left">

        <div class="logo">OmniPOS</div>
        <div class="tag">
            Omnichannel POS & Inventory Management
        </div>

        <div class="character">

            <div class="boss" id="boss">
                <div class="boss-eye">
                    <div class="boss-pupil"></div>
                </div>

                <div class="boss-eye">
                    <div class="boss-pupil"></div>
                </div>
            </div>

            <div class="parcel">

                <div class="tape"></div>

                <div class="eye left-eye">
                    <div class="pupil"></div>
                </div>

                <div class="eye right-eye">
                    <div class="pupil"></div>
                </div>

                <div class="mouth"></div>
            </div>
        </div>
    </div>

    <div class="right">

        <div class="form-box">
            <h2 id="title">Sign In</h2>
            <p>Manage sales, inventory & orders in one place.</p>

            <div class="input-group">
                <input type="email" placeholder="Email Address">
            </div>

            <div class="input-group" id="nameField" style="display:none;">
                <input type="text" placeholder="Full Name">
            </div>

            <div class="input-group">
                <input type="password" id="password"
                placeholder="Password">
            </div>

            <button class="btn">
                Continue
            </button>

            <div class="switch">
                <span onclick="toggleForm()">
                    Create account
                </span>
            </div>

        </div>

    </div>

</div>

<script>

const pupils = document.querySelectorAll(".pupil");
const bossPupils = document.querySelectorAll(".boss-pupil");
const password = document.getElementById("password");
const boss = document.getElementById("boss");

document.addEventListener("mousemove", (e)=>{

    const x = (e.clientX / window.innerWidth - .5) * 12;
    const y = (e.clientY / window.innerHeight - .5) * 12;

    pupils.forEach(p=>{
        p.style.transform =
        `translate(${x}px,${y}px)`;
    });

    bossPupils.forEach(p=>{
        p.style.transform =
        `translate(${x}px,${y}px)`;
    });
});

// Boss + parcel both look away on password focus
password.addEventListener("focus", ()=>{

    boss.style.transform =
    "rotate(-10deg) translateX(50px)";

    // boss eyes
    bossPupils.forEach(p=>{
        p.style.transform =
        "translate(-10px,0px)";
    });

    // big parcel eyes
    pupils.forEach(p=>{
        p.style.transform =
        "translate(0px,0px)";
    });
});

password.addEventListener("blur", ()=>{

    boss.style.transform =
    "rotate(-10deg)";

    bossPupils.forEach(p=>{
        p.style.transform =
        "translate(-10px,0px)";
    });

    pupils.forEach(p=>{
        p.style.transform =
        "translate(0px,0px)";
    });
});

// Toggle sign in / sign up
function toggleForm(){

    const title =
    document.getElementById("title");

    const field =
    document.getElementById("nameField");

    const switchBtn =
    document.querySelector(".switch span");

    if(title.innerText === "Sign In"){
        title.innerText = "Sign Up";
        field.style.display = "block";
        switchBtn.innerText =
        "Already have an account?";
    }
    else{
        title.innerText = "Sign In";
        field.style.display = "none";
        switchBtn.innerText =
        "Create account";
    }
}

</script>

</body>
</html>
            
